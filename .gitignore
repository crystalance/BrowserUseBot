# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Secrets & local state
.env
# Ignore all local workspace state EXCEPT the harvested results, which we keep
# (per-environment: workspace/harvest/<production|dev|test>/...). The binary
# ledger is regenerable, so it stays out of git.
workspace/*
!workspace/harvest/
workspace/harvest/**/ledger.sqlite

# Tooling
.ruff_cache/
.pytest_cache/
